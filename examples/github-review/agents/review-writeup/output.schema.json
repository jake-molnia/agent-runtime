{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment",
    "findings"
  ],
  "properties": {
    "assessment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sources",
          "title",
          "explanation"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        }
      }
    }
  }
}
